#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
/* DYA Studio のランタイムマクロ (&rmacro <slot>) */
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* ZMK 側で 10 が定義済みなので警告回避のため一旦 undef */
#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
flavor = "balanced";
quick-tap-ms = <0>;
};

&lt {
quick-tap-ms = <200>;
flavor = "balanced";
};

&msc {
delay-ms = <0>;
time-to-max-speed-ms = <0>;
acceleration-exponent = <0>;
};

/ {
/* DYA Studio のランタイムコンボ (zmk-feature-runtime-combo) のコンパイル時デフォルト。
 * 旧 zmk,combos から移行。DYA Studio から編集でき、Reset to Default でここの値に戻る。 */
runtime_combo_defaults {
compatible = "cormoran,runtime-combo-defaults";

layer4_ESC {
slot = <0>;
bindings = <&lt 2 ESC>;  /* MOUSE_W */
key-positions = <39 38>;
};

tab {
slot = <1>;
bindings = <&kp TAB>;
key-positions = <11 12>;
};
};

macros {
to_layer_0: to_layer_0 {
compatible = "zmk,behavior-macro-one-param";
#binding-cells = <1>;
bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
label = "TO_LAYER_0";
};

screenshot: screenshot {
compatible = "zmk,behavior-macro";
#binding-cells = <0>;
bindings =
<&macro_press>,
<&kp LEFT_GUI &kp RSHIFT>,
<&macro_wait_time 20>,
<&macro_tap>,
<&kp S>,
<&macro_release>,
<&kp LEFT_GUI &kp RSHIFT>;

label = "SCREENSHOT";
};

henkan: henkan {
compatible = "zmk,behavior-macro";
#binding-cells = <0>;
bindings =
<&macro_press>,
<&kp LEFT_ALT>,
<&macro_wait_time 20>,
<&macro_tap>,
<&kp GRAVE>,
<&macro_release>,
<&kp LEFT_ALT>;

label = "HENKAN";
};
};

behaviors {
lt_to_layer_0: lt_to_layer_0 {
compatible = "zmk,behavior-hold-tap";
label = "LAYER_TAP_TO_0";
bindings = <&mo>, <&to_layer_0>;

#binding-cells = <2>;
tapping-term-ms = <200>;
};

tp_repeat_mo1: tp_repeat_mo1 {
compatible = "zmk,behavior-hold-tap";
label = "TP_REPEAT_MO1";
bindings = <&mo>, <&key_repeat>;

#binding-cells = <2>;
tapping-term-ms = <200>;
};

// エンコーダ用 runtime-configurable sensor rotate
// デフォルトはスクロール (cw=SCRL_DOWN, ccw=SCRL_UP)
// DYA Studio Web UI から レイヤーごとに cw/ccw の binding を
// kp C_VOL_UP/DN や kp LEFT/RIGHT などへ動的変更可能
rsr_default: rsr_default {
compatible = "zmk,behavior-runtime-sensor-rotate";
#sensor-binding-cells = <0>;
tap-ms = <16>;
cw-binding = <&msc SCRL_DOWN>;
ccw-binding = <&msc SCRL_UP>;
};

tog_on: toggle_layer_on_only {
compatible = "zmk,behavior-toggle-layer";
#binding-cells = <1>;
display-name = "Toggle Layer On";
toggle-mode = "on";
};

tog_off: toggle_layer_off_only {
compatible = "zmk,behavior-toggle-layer";
#binding-cells = <1>;
display-name = "Toggle Layer Off";
toggle-mode = "off";
};

zfold: zfold {
compatible = "zmk,behavior-hold-tap";
label = "ZFOLD";
bindings = <&kp>, <&kp>;

#binding-cells = <2>;
tapping-term-ms = <300>;
flavor = "hold-preferred";
quick-tap-ms = <150>;
hold-while-undecided;
};

zfoldZ: zfoldZ {
compatible = "zmk,behavior-tap-dance";
label = "ZFOLDZ";
#binding-cells = <0>;
bindings = <&zfold LEFT_SHIFT Z>, <&kp LS(Z)>;
};
};

    keymap {
        compatible = "zmk,keymap";

        win_layer {
            display-name = "WIN";
            bindings = <
                &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P    &kp A    &kp S
                &kp D    &kp F    &kp G    &kp RIGHT_BRACKET    &kp H    &kp J    &kp K    &kp L    &lt 3 SEMICOLON    &mt LEFT_SHIFT Z    &kp X    &kp C
                &kp V    &kp B    &lt 3 INT4    &kp NON_US_HASH    &kp N    &kp M    &kp COMMA    &kp PERIOD    &lt 6 SLASH    &kp RIGHT_CONTROL    &kp LEFT_GUI    &kp LEFT_ALT
                &lt 1 GRAVE    &lt 2 SPACE    &mkp MB1    &lt 4 RETURN    &lt 5 BACKSPACE    &kp RIGHT_SHIFT
            >;
            sensor-bindings = <&rsr_default>, <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        num_w_layer {
            display-name = "NUM_W";
            bindings = <
                &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp TAB    &none
                &none    &kp SEMICOLON    &kp MINUS    &kp PAGE_UP    &kp 34013235    &kp 34013215    &kp UP    &none    &kp INT1    &kp 34013227    &none    &none
                &kp 17235974    &kp 17235993    &trans    &kp PAGE_DOWN    &none    &kp LEFT    &kp DOWN    &kp RIGHT    &kp 34013321    &kp LEFT_CONTROL    &kp LEFT_GUI    &kp LEFT_ALT
                &trans    &trans    &trans    &kp RETURN    &kp DELETE    &mkp MB2
            >;
            sensor-bindings = <&rsr_default>;
        };

        mouse_w_layer {
            display-name = "MOUSE_W";
            bindings = <
                &kp 34013214    &kp LEFT_BRACKET    &kp 34013216    &kp 34013217    &kp 34013218    &kp EQUAL    &kp 34013219    &kp 34013236    &kp 34013221    &kp 34013222    &kp TAB    &none
                &none    &kp SQT    &kp 34013319    &kp HOME    &kp 34013229    &kp 34013220    &none    &none    &none    &none    &none    &none
                &none    &mkp MB2    &kp EQUAL    &kp END    &none    &none    &kp RIGHT_BRACKET    &kp NON_US_HASH    &kp INT3    &kp LEFT_CONTROL    &trans    &trans
                &trans    &trans    &mkp MB2    &kp RETURN    &kp BACKSPACE    &mkp MB2
            >;
            sensor-bindings = <&rsr_default>;
        };

        scrl_w_layer {
            display-name = "SCRL_W";
            bindings = <
                &kp ESCAPE    &kp 50790443    &none    &kp 17236011    &none    &kp PAGE_UP    &trans    &kp UP    &kp TAB    &kp RIGHT_ALT    &kp HOME    &none
                &none    &none    &none    &kp HOME    &kp PAGE_DOWN    &kp LEFT    &kp DOWN    &kp RIGHT    &trans    &kp LEFT_SHIFT    &none    &none
                &none    &none    &trans    &kp END    &trans    &mkp MB1    &mkp MB3    &mkp MB2    &trans    &trans    &trans    &trans
                &kp 84344908    &kp TAB    &kp ESCAPE    &trans    &trans    &trans
            >;
            sensor-bindings = <&rsr_default>;
        };

        fn_w_layer {
            display-name = "FN_W";
            bindings = <
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp KP_N7    &kp KP_N8    &kp KP_N9    &kp KP_N0    &kp PRINTSCREEN    &kp F6    &kp F7
                &kp F8    &kp F9    &kp F10    &kp 151453776    &kp KP_N4    &kp KP_N5    &kp KP_N6    &kp 34013221    &trans    &trans    &trans    &trans
                &kp F11    &kp F12    &trans    &kp 151453775    &kp KP_N1    &kp KP_N2    &kp KP_N3    &kp 34013222    &kp KP_FSLH    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        fn2_layer {
            display-name = "FN2";
            bindings = <
                &none    &none    &none    &none    &trans    &kp F7    &kp F8    &kp F9    &kp F10    &kp RIGHT_ALT    &none    &none
                &none    &none    &none    &kp 168230992    &kp F4    &kp F5    &kp F6    &kp F11    &trans    &none    &none    &trans
                &none    &trans    &trans    &kp 168230991    &kp F1    &kp F2    &kp F3    &kp F12    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        ble_w_layer {
            display-name = "BLE_W";
            bindings = <
                &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &kp F6    &kp F7
                &kp F8    &kp F9    &trans    &trans    &trans    &trans    &trans    &trans    &studio_unlock    &trans    &kp N1    &kp N2
                &kp N3    &trans    &trans    &bootloader    &trans    &trans    &trans    &trans    &bt BT_CLR    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &bootloader    &bt BT_CLR_ALL
            >;
        };
    };
};

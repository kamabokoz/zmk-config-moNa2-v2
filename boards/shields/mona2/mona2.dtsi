#include <dt-bindings/zmk/matrix_transform.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <physical_layouts.dtsi>
/* NOTE: <input/processors/runtime-input-processor.dtsi> は最終的に
   modifiers.h を引き込み RC(keycode) を 1 引数で再定義するため、
   このファイル内のマトリクス RC(row,col) と衝突する。
   そのため runtime-input-processor.dtsi は overlay 側で
   `#include "mona2.dtsi"` の後に include すること。 */

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "default_layout";

        kscan = <&kscan0>;
        transform = <&default_transform>;

        /* mona2-ver3_topplate.stl のスイッチ穴から算出
           1u = 17.05mm（プレートのキーピッチ）、rot は 1/100 度（時計回り正）
           左右の間隔のみ表示用に詰めている（右半分を STL 配置から -264 移動） */
        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   69       0     0     0>   // 0
            , <&key_physical_attrs 100 100  100   28       0     0     0>   // 1
            , <&key_physical_attrs 100 100  200    0       0     0     0>   // 2
            , <&key_physical_attrs 100 100  300   15       0     0     0>   // 3
            , <&key_physical_attrs 100 100  400   29       0     0     0>   // 4
            , <&key_physical_attrs 100 100  900   32       0     0     0>   // 5
            , <&key_physical_attrs 100 100 1000   17       0     0     0>   // 6
            , <&key_physical_attrs 100 100 1100    3       0     0     0>   // 7
            , <&key_physical_attrs 100 100 1200   30       0     0     0>   // 8
            , <&key_physical_attrs 100 100 1300   71       0     0     0>   // 9
            , <&key_physical_attrs 100 100    0  169       0     0     0>   // 10
            , <&key_physical_attrs 100 100  100  128       0     0     0>   // 11
            , <&key_physical_attrs 100 100  200  100       0     0     0>   // 12
            , <&key_physical_attrs 100 100  300  115       0     0     0>   // 13
            , <&key_physical_attrs 100 100  400  129       0     0     0>   // 14
            , <&key_physical_attrs 100 100  800  170       0     0     0>   // 15
            , <&key_physical_attrs 100 100  900  132       0     0     0>   // 16
            , <&key_physical_attrs 100 100 1000  117       0     0     0>   // 17
            , <&key_physical_attrs 100 100 1100  103       0     0     0>   // 18
            , <&key_physical_attrs 100 100 1200  130       0     0     0>   // 19
            , <&key_physical_attrs 100 100 1300  171       0     0     0>   // 20
            , <&key_physical_attrs 100 100    0  269       0     0     0>   // 21
            , <&key_physical_attrs 100 100  100  228       0     0     0>   // 22
            , <&key_physical_attrs 100 100  200  200       0     0     0>   // 23
            , <&key_physical_attrs 100 100  300  215       0     0     0>   // 24
            , <&key_physical_attrs 100 100  400  229       0     0     0>   // 25
            , <&key_physical_attrs 100 100  500  260       0     0     0>   // 26
            , <&key_physical_attrs 100 100  800  270       0     0     0>   // 27
            , <&key_physical_attrs 100 100  900  232       0     0     0>   // 28
            , <&key_physical_attrs 100 100 1000  217       0     0     0>   // 29
            , <&key_physical_attrs 100 100 1100  203       0     0     0>   // 30
            , <&key_physical_attrs 100 100 1200  230       0     0     0>   // 31
            , <&key_physical_attrs 100 100 1300  271       0     0     0>   // 32
            , <&key_physical_attrs 100 100    0  369       0     0     0>   // 33
            , <&key_physical_attrs 100 100  100  328       0     0     0>   // 34
            , <&key_physical_attrs 100 100  200  300       0     0     0>   // 35
            , <&key_physical_attrs 100 100  336  352       0     0     0>   // 36
            , <&key_physical_attrs 100 100  445  361    1000   495   411>   // 37
            , <&key_physical_attrs 100 100  550  390    2000   600   440>   // 38
            , <&key_physical_attrs 100 100  756  406 (-2000)   806   456>   // 39
            , <&key_physical_attrs 100 100  867  376 (-1000)   917   426>   // 40
            , <&key_physical_attrs 100 100 1300  371       0     0     0>   // 41
            ;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <4>;               
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)             RC(3,6) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(3,7) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)     RC(3,8) RC(3,9)                         RC(3,10)         
        >;
    };
    
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";
            row-gpios
                = <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
                , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
                , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
                , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 			
                ;
    };

    //right hand trackball
    trackball_central_listener: trackball_central_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        /* DYA Studio で動的に編集できるよう、入力プロセッサは
           overlay 側で &mouse_runtime_input_processor /
           &scroll_runtime_input_processor へ委譲する */
    };

    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <96>;
        status = "disabled";
    };

    right_encoder: encoder_right {
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <24>;
    };

};
